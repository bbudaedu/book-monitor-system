{
  "name": "book-monitor-system",
  "version": "1.0.0",
  "description": "自動化書籍監控系統 - 監控佛教教育基金會網站新書並自動下載PDF",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --project tsconfig.test.json --skipLibCheck --noEmitOnError false 2>/dev/null || exit 0; npm run copy-renderer",
    "copy-renderer": "node scripts/copy-renderer.js",
    "start": "npm run copy-renderer && npx electron .",
    "dev": "npm run build && electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=src/.*\\.test\\.ts$",
    "test:integration": "jest --testPathPattern=integration",
    "test:ci": "jest --coverage --watchAll=false --passWithNoTests",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "pack": "electron-builder"
  },
  "keywords": [
    "electron",
    "book",
    "monitor",
    "pdf",
    "line",
    "notification"
  ],
  "author": "Book Monitor System",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "electron": "^38.1.2",
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@line/bot-sdk": "^10.2.0",
    "@neondatabase/serverless": "^0.7.0",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.6.0",
    "dotenv": "^17.2.2",
    "electron-updater": "^6.6.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.0",
    "puppeteer": "^24.22.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "build": {
    "appId": "com.bookmonitor.app",
    "productName": "Book Monitor System",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico"
    }
  }
}
